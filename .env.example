# ==========================================
# AI FITNESS COACH - ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ai_fitness_coach

# Firebase Admin SDK Configuration (for server-side token verification)
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Option B: Project ID (if using default application credentials or public key validation)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_AI_ENGINE_WS_URL=ws://localhost:8000/ws/workout

# Firebase Client SDK Configuration (Safe for browser/frontend exposure)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ------------------------------------------
# AI ENGINE CONFIGURATION (ai-engine/.env)
# ------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
AI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AI_MODEL_PATH=./models/saved/exercise_classifier.pkl
CAMERA_INDEX=0
AI_DEBUG_OVERLAY=true
